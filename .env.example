# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# --- Obrigatórias ---

# Token de acesso à API Olho Vivo (SPTrans). Solicitado em:
# http://www.sptrans.com.br/desenvolvedores/
SafeMooveTOKENolhovivo="seu-token-aqui"

# Credenciais AWS do usuário/role usado pelo consumer_s3.py e pelos
# scripts de setup do Athena/Glue. Precisa de permissão de escrita no
# bucket S3 de destino (S3_BUCKET) e, para a camada de analytics,
# glue:CreateDatabase/CreateTable e athena:StartQueryExecution/GetQuery*.
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=us-east-1

# --- Opcionais (todas têm default no código, listadas aqui só pra
# referência — só declare se quiser sobrescrever o comportamento padrão) ---

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# producer_linhas.py
# LINHAS_REQUEST_INTERVAL=0.8
# LINHAS_MAX_ENCONTRADAS=            # vazio = descoberta completa (produção); um número, ex. 300, limita a busca pra testes rápidos

# producer_posicoes.py
# POSICOES_POLL_INTERVAL=10

# producer_previsao.py
# PREVISOES_REQUEST_INTERVAL=1.0
# PREVISOES_REFRESH_INTERVAL=300

# consumer_s3.py
# S3_BUCKET=safe-moove-raw
# S3_BATCH_SIZE=500
# S3_BATCH_INTERVAL_SECONDS=60
